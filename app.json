{
  "expo": {
    "name": "LingoSpark",
    "slug": "lingospark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lingospark.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LingoSpark использует микрофон, чтобы вы могли записывать и сравнивать своё произношение."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C5CFC"
      },
      "edgeToEdgeEnabled": true
    }
  }
}

