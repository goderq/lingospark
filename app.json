{
  "expo": {
    "name": "LingoSpark",
    "slug": "lingospark",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lingospark.app",
      "buildNumber": "16",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LingoSpark использует микрофон, чтобы вы могли записывать и сравнивать своё произношение.",
        "NSSpeechRecognitionUsageDescription": "LingoSpark распознаёт вашу английскую речь локально, чтобы ИИ-преподаватель мог поддерживать разговор.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C5CFC"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7f33d965-f80c-4e1d-abf7-252be0c47ca5"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-notifications",
      "expo-build-properties",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите LingoSpark слышать вашу речь для разговорной практики.",
          "speechRecognitionPermission": "Разрешите LingoSpark локально преобразовывать английскую речь в текст."
        }
      ],
      [
        "@pocketpalai/llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "sideloadly",
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ]
  }
}
